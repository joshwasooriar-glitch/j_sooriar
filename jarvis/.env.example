# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY. Bypasses RLS.

# ---------- OpenAI ----------
OPENAI_API_KEY=                     # SERVER ONLY

# Verify these against the live API before first deploy. Names change.
JARVIS_DEFAULT_MODEL=gpt-6-luna
JARVIS_ADVANCED_MODEL=gpt-6-sol
JARVIS_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Budget, in cents ----------
JARVIS_MONTHLY_BUDGET_CENTS=1000    # $10.00 hard ceiling
JARVIS_WARN_CENTS=700               # dashboard banner
JARVIS_RESTRICT_CENTS=850           # advanced model needs confirmation
JARVIS_HARD_STOP_CENTS=950          # advanced model disabled

# ---------- Ops ----------
CRON_SECRET=                        # shared secret, Supabase cron to Next.js
JARVIS_TIMEZONE=America/New_York

# ---------- Seeding, local only ----------
SEED_USER_ID=                       # auth.users id to attach seed data to

# ---------- Milestone 2 ----------
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_TOKEN=

# ---------- Milestone 4 ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
